# Copy to .env and fill in from your free Supabase project (Project Settings → API).
# Leave unset to run in local mode (no accounts, progress stored on-device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ElevenLabs API key for read-aloud TTS (optional).
# Audio is cached in IndexedDB so each unique text is only fetched once.
# Get your key at elevenlabs.io → Profile → API Keys.
VITE_ELEVENLABS_KEY=
